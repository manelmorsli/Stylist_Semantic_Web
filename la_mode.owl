    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/manel/ontologies/2025/1/la_mode#Mode_des_Sneakers">
        <rdf:type rdf:resource="http://www.semanticweb.org/manel/ontologies/2025/1/la_mode#Tendance"/>
        <la_mode:nom>Mode des Sneakers</la_mode:nom>
        <la_mode:description>Tout le monde adopte les baskets comme pièce vestimentaire incontournable, du sportif au luxe.</la_mode:description>
